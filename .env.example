APP_ENV=development
APP_NAME=agentic-support
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
# Private-demo access: map user IDs to unique random tokens (at least 32 characters).
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example format: AUTH_TOKENS={"u_demo":"paste-generated-token-here"}
# Chat is disabled until at least one token is configured. Never put tokens in VITE_*.
AUTH_TOKENS={}
# Knowledge directory; all documents are ingested at startup.
KNOWLEDGE_DIR=knowledge

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Dense retrieval: local English-capable BAAI/bge-small-en-v1.5.
# The compatible embeddings API is used when its key and base URL are set.
# APP_ENV=testing skips the model unless LOCAL_EMBEDDING_FORCE=true.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIM=384
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_FORCE=false

# Rerank: local Cross-Encoder (BAAI/bge-reranker-base).
# pip install -e ".[rerank]"  then the first request downloads weights.
# APP_ENV=testing skips the model unless CROSS_ENCODER_FORCE=true.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_FORCE=false
# Optional Hugging Face model mirror endpoint.
HF_ENDPOINT=https://huggingface.co

# Document ingest: Unstructured for PDF/Office/HTML/images. Markdown heading
# split is the fallback when the extra is missing or APP_ENV=testing.
# pip install -e ".[docs]"  plus system packages: poppler, tesseract,
# libreoffice (for DOCX/PPTX).
UNSTRUCTURED_ENABLED=true
UNSTRUCTURED_STRATEGY=auto
UNSTRUCTURED_OCR_LANGUAGES=eng
UNSTRUCTURED_FORCE=false

# MCP: local tools are registered by default; set a URL to add a remote HTTP tool.
MCP_ENABLED=true
MCP_REMOTE_URL=

# Persistence: local quick start uses SQLite and in-process fallbacks.
# docker compose overrides these with Postgres, Redis and Qdrant URLs.
DATABASE_URL=sqlite+aiosqlite:///./data/local/app.db
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=cs_knowledge

# Retrieval
RETRIEVAL_TOP_K_SIMPLE=3
RETRIEVAL_TOP_K_COMPLEX=8
RRF_K=60
RERANK_TOP_N=5
MAX_RETRIEVAL_HOPS=3

# Memory
TOKEN_BUDGET=128000
COMPRESS_SOFT_RATIO=0.50
COMPRESS_HARD_RATIO=0.70
AUTO_COMPACT_RATIO=0.85

# Agent
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6

# Rate limit / cache / admin
RATE_LIMIT_PER_MINUTE=60
RETRIEVAL_CACHE_TTL_SECONDS=60
ADMIN_API_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
